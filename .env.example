# ============================================================
# ClipAI Studio — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in ALL values marked [REQUIRED]
# before running the application.  Never commit your real .env file.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your real values
# ============================================================


# ------------------------------------------------------------
# Flask Core  [REQUIRED in production]
# ------------------------------------------------------------

# Runtime environment.  Set to "production" to enable security
# hardening: SESSION_COOKIE_SECURE, HSTS headers, and strict
# validation of all required secrets at startup.
FLASK_ENV=development

# Debug mode.  MUST be 0 in production — Flask dev server is
# NOT safe for public traffic (interactive debugger, no workers).
FLASK_DEBUG=0

# Network binding.  In production, bind to 127.0.0.1 and let
# nginx/Caddy/a load balancer handle the public-facing port.
FLASK_PORT=5000
FLASK_HOST=127.0.0.1


# ------------------------------------------------------------
# Security Keys  [REQUIRED]
# ------------------------------------------------------------

# Flask session signing key.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: changing this invalidates all existing sessions.
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# Fernet symmetric encryption key for OAuth tokens stored in DB.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, the app falls back to deriving one from SECRET_KEY — set
# this explicitly in production so token encryption is independent
# of your session key.
ENCRYPTION_KEY=generate-a-32-byte-urlsafe-base64-key-for-oauth-token-encryption


# ------------------------------------------------------------
# Google / YouTube API  [REQUIRED]
# ------------------------------------------------------------

# YouTube Data API v3 key (for video metadata, transcript lookup,
# and Creative Commons channel discovery).
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Google OAuth 2.0 Web Client ID (backend & frontend).
# For frontend build (Vercel / Vite), use VITE_GOOGLE_CLIENT_ID with this same value.
# Create at: https://console.cloud.google.com → OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret (required for server-side token refresh).
# Found next to the Client ID in the Google Cloud Console.
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here

# Frontend base URL for backend API (when frontend is deployed separately on Vercel)
# Leave empty for local development
VITE_API_BASE_URL=



# ------------------------------------------------------------
# AI Provider  [REQUIRED for highlight analysis]
# ------------------------------------------------------------

# Groq Cloud API key (LLaMA 3.3 70B for transcript analysis & SEO metadata).
# Free tier available at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here


# ------------------------------------------------------------
# Administration  [REQUIRED in production]
# ------------------------------------------------------------

# Secret key for the POST /api/admin/cleanup endpoint.
# Pass as X-Admin-Key header.  Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your_admin_secret_key_here


# ------------------------------------------------------------
# Optional: Pipeline & Model Settings
# ------------------------------------------------------------

# Whisper model size for local speech recognition.
# Options: tiny (fastest, least accurate), base, small, medium, large-v3
# OPTIONAL — defaults to "tiny" if not set.
WHISPER_MODEL_SIZE=tiny

# Redis connection string for the RQ background job queue.
# OPTIONAL — if Redis is unavailable, jobs fall back to Python threads.
REDIS_URL=redis://localhost:6379/0

# SQLAlchemy database URI.
# OPTIONAL — defaults to SQLite (suitable for development only).
# For production use PostgreSQL: postgresql://user:pass@host/dbname
SQLALCHEMY_DATABASE_URI=sqlite:///yt_upl2.db